{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portalfrete-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "vars": {"TENANT_PORTAL_ENABLED": "enabled", "SUPER_ADMIN_OWNER_PORTAL_WRITES": "enabled", "SUPER_ADMIN_TENANT_WRITES": "enabled", "SUPER_ADMIN_MEMBERSHIP_WRITES": "enabled", "SUPER_ADMIN_BRAND_WRITES": "enabled", "SUPER_ADMIN_CREDENTIAL_WRITES": "enabled", "SUPER_ADMIN_PIN_REQUIRED": "enabled"},
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "84be58f84dc54949af897d6f63c69689"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CLIENT_LOGOS",
      "bucket_name": "portal-clientes"
    },
    {
      "binding": "FLEET_FILES",
      "bucket_name": "portal-frota-documentos"
    },
    {
      "binding": "TENANT_BRANDS",
      "bucket_name": "portal-super-admin-brands-staging"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GAMES_ROOMS",
        "class_name": "GamesRoom"
      },
      {
        "name": "CINE_ACCESS",
        "class_name": "CineAccess"
      },
      {
        "name": "SINUCA_ROOMS",
        "class_name": "SinucaRoom"
      },
      {
        "name": "PINGO_STORE",
        "class_name": "PingoStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "games-v1",
      "new_sqlite_classes": [
        "GamesRoom"
      ]
    },
    {
      "tag": "cine-access-v1",
      "new_sqlite_classes": [
        "CineAccess"
      ]
    },
    {
      "tag": "sinuca-v1",
      "new_sqlite_classes": [
        "SinucaRoom"
      ]
    },
    {
      "tag": "pingochic-v1",
      "new_sqlite_classes": [
        "PingoStore"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "FLEET_DB",
      "database_name": "portal-frota",
      "database_id": "3cce5e65-1d2f-4232-847a-9a518bfa833d"
    },
    {
      "binding": "TENANTS_DB",
      "database_name": "portal-super-admin-tenants-staging",
      "database_id": "9103c28a-c224-4781-9d3f-fd735b546cd9"
    }
  ]
}
